<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <!-- HEADER -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            android:paddingTop="20dp"
            android:paddingBottom="12dp">

            <ImageView
                android:id="@+id/btnBack"
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="16dp"
                android:src="@drawable/back"
                android:contentDescription="@string/common_cancel"
                android:clickable="true"
                android:focusable="true"
                android:background="?attr/selectableItemBackgroundBorderless"/>

            <ImageButton
                android:id="@+id/btnEdit"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_alignParentEnd="true"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="8dp"
                android:src="@drawable/ic_edit_24"
                android:contentDescription="Editar"/>

        </RelativeLayout>

        <!-- MAIN CARD -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="3dp"
            app:strokeWidth="1dp"
            app:strokeColor="#E0E0E0"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <!-- TOP ROW -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- STATUS -->
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ABIERTA"
                        android:textStyle="bold"
                        android:textSize="12sp"
                        android:textColor="#C62828"
                        android:clickable="true"
                        android:focusable="true"
                        app:chipBackgroundColor="#FDECEC"
                        app:chipCornerRadius="12dp"
                        app:chipMinHeight="34dp"
                        app:chipStrokeWidth="0dp"
                        tools:text="ABIERTA"/>

                    <!-- TYPE -->
                    <TextView
                        android:id="@+id/tvType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:text="INCIDENCIA"
                        android:textStyle="bold"
                        android:textSize="13sp"
                        android:textColor="#757575"
                        tools:text="INCIDENCIA"/>

                </LinearLayout>

                <!-- TITLE -->
                <TextView
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:textSize="28sp"
                    android:textStyle="bold"
                    android:textColor="#212121"
                    android:lineSpacingExtra="2dp"
                    tools:text="Falta hormigón en planta 2"/>

                <!-- DESCRIPTION -->
                <TextView
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:textSize="16sp"
                    android:lineSpacingExtra="6dp"
                    android:textColor="#424242"
                    tools:text="El pedido de hormigón no llegó a tiempo y la obra queda parada temporalmente. Se espera nueva entrega para mañana por la mañana."/>

                <!-- DIVIDER -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="20dp"
                    android:background="#EEEEEE"/>

                <!-- STRUCTURED DATA TITLE -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Structured Data"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="#212121"/>

                <!-- STRUCTURED DATA -->
                <TextView
                    android:id="@+id/tvStructuredData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:textColor="#616161"
                    android:textSize="15sp"
                    android:lineSpacingExtra="4dp"
                    tools:text="Zona: Planta 2&#10;Material: Hormigón&#10;Prioridad: Alta"/>

                <!-- DIVIDER -->
                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="24dp"
                    android:layout_marginBottom="20dp"
                    android:background="#EEEEEE"/>

                <!-- METADATA -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tvCreatedBy"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="#616161"
                        android:textSize="15sp"
                        tools:text="👤 Por Rocío"/>

                    <TextView
                        android:id="@+id/tvDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:textColor="#616161"
                        android:textSize="15sp"
                        tools:text="🕒 15 mayo 2026 · 13:42"/>

                </LinearLayout>

                <!-- IMAGES SECTION -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="28dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Imágenes"
                            android:textStyle="bold"
                            android:textSize="18sp"
                            android:textColor="#212121"/>

                        <com.google.android.material.floatingactionbutton.FloatingActionButton
                            android:id="@+id/btnAddImage"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="12dp"
                            android:contentDescription="Añadir imagen"
                            app:srcCompat="@android:drawable/ic_menu_camera"
                            app:fabSize="mini"
                            app:backgroundTint="#6750A4"
                            app:tint="@android:color/white"
                            app:borderWidth="0dp"
                            app:elevation="2dp"/>
                    </LinearLayout>

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvImages"
                        android:layout_width="match_parent"
                        android:layout_height="100dp"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal"
                        tools:listitem="@layout/item_record_image"/>

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

</ScrollView>